# LaTeX build artifacts
# cv/ and publist/ hold tracked sources (main.tex, resume.cls, author-filter.tex,
# README.md); everything below is regenerated by `make update-cv` / `make update-publist`.
# The per-directory My-Publications.bib is a copy of the master bib at the repo root,
# not a source file. Scoped to the two document directories on purpose — an unscoped
# *.aux would silently swallow files anywhere else in the repo.
cv/*.aux
cv/*.bbl
cv/*.bcf
cv/*.blg
cv/*.bpx
cv/*.out
cv/*.run.xml
cv/*.synctex.gz
cv/main.pdf
cv/My-Publications.bib
publist/*.aux
publist/*.bbl
publist/*.bcf
publist/*.blg
publist/*.bpx
publist/*.out
publist/*.run.xml
publist/*.synctex.gz
publist/main.pdf
publist/My-Publications.bib

# Logs
logs/
*.log

# Skill share bundles (make package-publist-skill)
dist/

# Vercel build tooling cache
.tools/
.vercel/
